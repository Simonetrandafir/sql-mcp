{
  "name": "sql-mcp",
  "version": "1.0.0",
  "description": "SQL Server and PostgreSQL MCP server — query and manage databases, schemas, tables and data",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:exe": "npm run build && node scripts/build-exe.mjs",
    "test:exe": "node --test scripts/test-exe.mjs",
    "test:connection": "node scripts/test-connection.mjs",
    "test:write": "node scripts/test-connection.mjs --write",
    "test": "npm run build && node --test scripts/test-query.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "scaffold": "tsx scripts/scaffold-provider.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mssql": "^12.7.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "volta": {
    "node": "26.13.0"
  }
}
